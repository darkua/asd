# ─── JIRA ───────────────────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=your-atlassian-api-token
JIRA_PROJECT_KEY=MOW

# Label that triggers AI implementation (default: AI-GEN)
JIRA_TRIGGER_LABEL=AI-GEN

# Status to transition to after PR is created (default: In Review)
JIRA_DONE_STATUS=In Review

# ─── Git / Repository ───────────────────────────
# Absolute path to the git repo where the agent will work
REPO_PATH=/home/maciej/projects/mowafaqa-backend

# Base branch for new feature branches (default: develop)
REPO_BASE_BRANCH=develop

# Git remote name (default: origin)
REPO_REMOTE=origin
# Create PRs as drafts by default (true|false)
BRANCH_DRAFT=true

# ─── Slack ────────────────────https://01ed-89-214-115-60.ngrok-free.app──────────────────
# Optional: Slack incoming webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../xxx
SLACK_CHANNEL=

# ─── GitHub Integration (optional) ──────────────
# Set to "true" to enable GitHub PR comment feedback loop
GITHUB_INTEGRATION_ENABLED=false

# GitHub personal access token (or use GH_TOKEN)
# GITHUB_TOKEN=ghp_...

# Webhook secret for verifying GitHub webhook payloads
# GITHUB_WEBHOOK_SECRET=your-webhook-secret

# Bot username (used to strip @mentions from commands)
# GITHUB_BOT_USERNAME=my-bot

# ─── Worker ─────────────────────────────────────
# Poll interval in ms (default: 900000 = 15 min)
POLL_INTERVAL_MS=900000

# Max concurrent tasks (default: 1 — sequential)
MAX_CONCURRENT=1

# claude | cursor — which CLI implements tasks (default: claude)
AGENT_PROVIDER=claude

# Optional model id passed to selected provider CLI.
# - Claude: used as `--model <AGENT_MODEL>`
# - Cursor Agent: used as `--model <AGENT_MODEL>`
# AGENT_MODEL=

# Max agent turns per task (default: 100). Legacy: CLAUDE_MAX_TURNS
AGENT_MAX_TURNS=30

# Timeout per task in ms (default: 600000 = 10 min). Legacy: CLAUDE_TIMEOUT_MS
AGENT_TIMEOUT_MS=600000

# ─── Cursor Agent (when AGENT_PROVIDER=cursor) ──
# Worker writes the combined prompt to a temp file and runs: sh -c '"$CURSOR_AGENT_BIN" -p -f --trust "$(cat "$CURSOR_PROMPT_FILE")"' with cwd = worktree.
# Default is `agent` on PATH; override if needed.
# CURSOR_AGENT_BIN=agent
# If the worker finds `agent` in the log as "(not found)" but your terminal works, prepend the same PATH segment your shell uses:
# CURSOR_AGENT_PATH_PREPEND=/opt/homebrew/bin
# Last resort: pass the full process env to the agent (also forwards any secrets loaded into the worker from .env):
# CURSOR_AGENT_INHERIT_ENV=true

# ─── Paths ──────────────────────────────────────
# File to store processed task state
STATE_FILE=./.worker-state.json

# Optional: log to file (leave empty for stdout only)
LOG_FILE=

# Health check HTTP port (default: 0 = disabled)
HEALTH_PORT=0

# ─── IMPORTANT ──────────────────────────────────
# Claude path: DO NOT set ANTHROPIC_API_KEY — we use MAX subscription.
# Authenticate once with: claude login
#
# Cursor path: use `cursor agent login` (or CURSOR_API_KEY for API billing if you choose).
